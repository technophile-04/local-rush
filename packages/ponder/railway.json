{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "yarn ponder:codegen"
  },
  "deploy": {
    "startCommand": "yarn ponder:start --schema $RAILWAY_DEPLOYMENT_ID",
    "healthcheckPath": "/ready",
    "healthcheckTimeout": 3600
  }
}
